<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!-- Only the pujari app tracks location in the background; the customer release must not request it. -->
  <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" tools:node="remove"/>
  <application>
    <activity android:name="com.bseva.app.MainActivity">
      <!-- App Links: customer booking links open in this app (verified by https://<host>/.well-known/assetlinks.json). -->
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="https"/>
        <data android:host="b-seva.com"/>
        <data android:host="qa.b-seva.com"/>
        <data android:path="/my-bookings"/>
        <data android:pathPrefix="/booking/"/>
        <data android:pathPrefix="/customer/"/>
        <!-- Puja pages, e.g. promotion links to /services/diwali-puja -->
        <data android:path="/services"/>
        <data android:pathPrefix="/services/"/>
        <data android:pathPrefix="/book/"/>
        <data android:path="/astrology"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
