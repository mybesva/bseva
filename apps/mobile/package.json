{
  "name": "@bseva/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "build:apk": "eas build --platform android --profile preview",
    "android:local": "expo run:android",
    "apk:local": "export EXPO_PUBLIC_API_URL=\"${EXPO_PUBLIC_API_URL:-https://bseva.vercel.app}\" && expo prebuild --platform android && cd android && ./gradlew assembleRelease -x lint -x lintVitalAnalyzeRelease -x lintVitalRelease -PreactNativeArchitectures=arm64-v8a"
  },
  "dependencies": {
    "@bseva/api-client": "file:../../packages/api-client",
    "@bseva/config": "file:../../packages/config",
    "@bseva/locales": "file:../../packages/locales",
    "@bseva/tokens": "file:../../packages/tokens",
    "@bseva/types": "file:../../packages/types",
    "@bseva/validation": "file:../../packages/validation",
    "@expo/vector-icons": "~14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@tanstack/react-query": "^5.90.2",
    "expo": "~53.0.27",
    "expo-build-properties": "~0.14.8",
    "expo-clipboard": "~7.1.5",
    "expo-constants": "~17.1.8",
    "expo-document-picker": "~13.1.6",
    "expo-font": "~13.3.2",
    "expo-image-picker": "~16.1.4",
    "expo-linking": "~7.1.7",
    "expo-location": "~18.1.6",
    "expo-notifications": "~0.31.5",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.5",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-webview": "13.13.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.14",
    "typescript": "~5.8.3"
  }
}
