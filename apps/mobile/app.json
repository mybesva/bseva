{
  "expo": {
    "name": "B-Seva",
    "slug": "bseva",
    "scheme": "bseva",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8E7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bseva.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "B-Seva uses the camera so you can take a profile photo, signature photo, or document photo instead of only picking from the library.",
        "NSPhotoLibraryUsageDescription": "B-Seva needs photo library access to attach documents and profile photos.",
        "NSLocationWhenInUseUsageDescription": "B-Seva uses your location during the pre-Puja travel period so the customer can track your arrival, and to find nearby pujaris or save your address.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "B-Seva uses your location during the pre-Puja travel period so the customer can track your arrival.",
        "NSLocationAlwaysUsageDescription": "B-Seva uses your location during the pre-Puja travel period so the customer can track your arrival.",
        "NSMicrophoneUsageDescription": "Microphone access is unused; this permission is only requested if a system picker requires it.",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "UIBackgroundModes": [
          "remote-notification",
          "location"
        ]
      }
    },
    "android": {
      "package": "com.bseva.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A2B4A"
      },
      "splash": {
        "image": "./assets/splash-android.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFF8E7"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "bseva"
            },
            {
              "scheme": "https",
              "host": "bseva.vercel.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "B-Seva uses your location during the pre-Puja travel period so the customer can track your arrival."
        }
      ],
      "expo-task-manager",
      [
        "expo-image-picker",
        {
          "photosPermission": "B-Seva needs photo library access to attach documents and profile photos.",
          "cameraPermission": "B-Seva uses the camera so you can take a profile photo, signature photo, or document photo."
        }
      ],
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8E7",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "enableFullScreenImage_legacy": true,
          "imageWidth": 200,
          "android": {
            "image": "./assets/splash-android.png",
            "backgroundColor": "#FFF8E7",
            "resizeMode": "contain",
            "enableFullScreenImage_legacy": true
          },
          "ios": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#FFF8E7",
            "resizeMode": "contain",
            "enableFullScreenImage_legacy": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF9933"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "ndkVersion": "27.1.12297006"
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": true
    }
  }
}
