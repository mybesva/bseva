{
  "expo": {
    "name": "B-Seva Admin",
    "slug": "bseva-admin",
    "scheme": "bsevaadmin",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8E7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bseva.admin",
      "appleTeamId": "67ZN9U655H",
      "googleServicesFile": "./GoogleService-Info.admin.plist",
      "buildNumber": "2",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "B-Seva Admin needs photo library access to attach verification documents and promo images.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bseva.admin",
      "versionCode": 2,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A2B4A"
      },
      "splash": {
        "image": "./assets/splash-android.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFF8E7"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "bsevaadmin"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "../mobile/plugins/withBsevaAndroid.js",
        {
          "keyName": "admin"
        }
      ],
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "B-Seva Admin needs photo library access to attach verification documents and promo images.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8E7",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "enableFullScreenImage_legacy": true,
          "imageWidth": 200,
          "android": {
            "image": "./assets/splash-android.png",
            "backgroundColor": "#FFF8E7",
            "resizeMode": "contain",
            "enableFullScreenImage_legacy": true
          },
          "ios": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#FFF8E7",
            "resizeMode": "contain",
            "enableFullScreenImage_legacy": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF7A00"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "ndkVersion": "27.1.12297006"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": true
    }
  }
}
