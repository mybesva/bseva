# HTTP-only bootstrap: used until the Let's Encrypt certificate for ${DOMAIN} exists.
limit_req_zone $binary_remote_addr zone=bseva_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=bseva_contact:1m rate=3r/m;
limit_req_zone $binary_remote_addr zone=bseva_api:10m rate=20r/s;
# Meta WhatsApp webhooks arrive in bursts from a few Meta addresses; signature-checked in the API.
limit_req_zone $binary_remote_addr zone=bseva_webhook:10m rate=50r/s;
# Access log without the query string ($uri, not $request): Meta sends the webhook verify token as a query parameter.
log_format bseva_noquery '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" '
                         '$status $body_bytes_sent $request_time "$http_user_agent" $request_id';
limit_req_status 429;
server_tokens off;

server {
    listen 80 default_server;
    server_name ${DOMAIN};

    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }

    include /etc/nginx/bseva-templates/common.inc;
}
