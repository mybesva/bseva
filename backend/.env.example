# FastAPI (used by pydantic-settings)
# Prefer Supabase Session pooler URI (IPv4) for Vercel/serverless and most hosts.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
JWT_SECRET=replace-with-32-plus-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STORAGE_BUCKET=bseva
# Comma-separated. Include your Vercel URL and any mobile origins later.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
OTP_DEV_CODE=123456
# development | production
ENVIRONMENT=development

# Zoho SMTP (backend-only — never put these in Vite/React/React Native)
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USERNAME=admin@b-seva.com
ZOHO_SMTP_PASSWORD=
ZOHO_FROM_EMAIL=admin@b-seva.com
ZOHO_FROM_NAME=BSeva
# If auth fails: try smtp.zoho.in or smtppro.zoho.com / smtppro.zoho.in for org/India DC.
# Generate an Application-specific Password in Zoho Account → Security when 2FA is on.
# ALLOW_EMAIL_TEST=1
# python3 -m scripts.send_test_emails

# Registration CAPTCHA (req #112). Enable via Admin Settings → registration_captcha_enabled.
# Site key is safe to expose to the browser (also set VITE_RECAPTCHA_SITE_KEY in the client env).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Local/dev only: set both secret and client token path to "dev-bypass" (never in production).

# Cron (req #99): run every 15–30 minutes
# python3 -c "from app.jobs.booking_reminders import send_upcoming_booking_reminders; print(send_upcoming_booking_reminders())"

# Telephony / RTC (req #101–102, #106) — provider credentials not wired yet.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# AGORA_APP_ID=

# Google Meet for virtual pujas
# Preferred: OAuth refresh token (personal Gmail / Workspace user)
#   1) Set GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET
#   2) Visit http://localhost:8000/api/v1/auth/google once
#   3) GOOGLE_REFRESH_TOKEN is written to .env automatically
# GOOGLE_MEET_ENABLED=1
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_MEET_TIMEZONE=Asia/Kolkata
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# GOOGLE_REFRESH_TOKEN=
# PUBLIC_APP_URL=https://bseva.vercel.app
# Optional Workspace service-account fallback:
# GOOGLE_SERVICE_ACCOUNT_FILE=
# GOOGLE_MEET_IMPERSONATE=

# --- Firebase Cloud Messaging (Admin SDK — backend only) ---
# Local: path to the downloaded firebase-adminsdk JSON (do not commit the file)
# GOOGLE_APPLICATION_CREDENTIALS=/Users/YOU/secrets/b-seva-61ab7-firebase-adminsdk-fbsvc-1a2e3a5b6a.json
# Production: the same JSON as a single-line env var
# FIREBASE_SERVICE_ACCOUNT_JSON=
# PUBLIC_APP_URL=http://localhost:5173
# FIREBASE_WEB_API_KEY=
# FIREBASE_WEB_AUTH_DOMAIN=
# FIREBASE_WEB_PROJECT_ID=b-seva-61ab7
# FIREBASE_WEB_STORAGE_BUCKET=
# FIREBASE_WEB_MESSAGING_SENDER_ID=
# FIREBASE_WEB_APP_ID=
# FIREBASE_WEB_VAPID_KEY=
