# FastAPI (used by pydantic-settings)
# Prefer Supabase Session pooler URI (IPv4) for Vercel/serverless and most hosts.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
JWT_SECRET=replace-with-32-plus-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STORAGE_BUCKET=bseva
# Comma-separated. Include your Vercel URL and any mobile origins later.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
OTP_DEV_CODE=123456
# development | production
ENVIRONMENT=development

# Registration CAPTCHA (req #112). Enable via Admin Settings → registration_captcha_enabled.
# Site key is safe to expose to the browser (also set VITE_RECAPTCHA_SITE_KEY in the client env).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Local/dev only: set both secret and client token path to "dev-bypass" (never in production).

# Cron (req #99): run every 15–30 minutes
# python3 -c "from app.jobs.booking_reminders import send_upcoming_booking_reminders; print(send_upcoming_booking_reminders())"

# Telephony / RTC (req #101–102, #106) — provider credentials not wired yet.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# AGORA_APP_ID=
