# ============================================================================
# B-SEVA LOCAL SETUP - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control
# ============================================================================

# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL Example:
# DATABASE_URL=postgresql://username:password@localhost:5432/bseva

# MySQL Example:
# DATABASE_URL=mysql://username:password@localhost:3306/bseva

DATABASE_URL=postgresql://postgres:password@localhost:5432/bseva

# AUTHENTICATION & SECURITY
# ============================================================================
# Generate a random 32+ character string for JWT_SECRET
# Example: openssl rand -base64 32
JWT_SECRET=your-secret-key-here-min-32-characters-required

# OAuth Configuration (from Manus platform)
VITE_APP_ID=your-manus-app-id
OAUTH_SERVER_URL=https://oauth.manus.im
VITE_OAUTH_PORTAL_URL=https://portal.manus.im

# OWNER INFORMATION
# ============================================================================
OWNER_NAME=Your Name
OWNER_OPEN_ID=your-open-id

# API CONFIGURATION
# ============================================================================
# Manus built-in APIs
BUILT_IN_FORGE_API_URL=https://api.manus.im
BUILT_IN_FORGE_API_KEY=your-api-key
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im
VITE_FRONTEND_FORGE_API_KEY=your-frontend-api-key

# APPLICATION SETTINGS
# ============================================================================
VITE_APP_TITLE=B-Seva
VITE_APP_LOGO=/logo.png

# ANALYTICS (Optional)
# ============================================================================
VITE_ANALYTICS_ENDPOINT=https://analytics.manus.im
VITE_ANALYTICS_WEBSITE_ID=your-website-id

# SMS GATEWAY CONFIGURATION (Optional - for OTP and notifications)
# ============================================================================
# Twilio Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Alternative: MSG91 Configuration
# MSG91_AUTH_KEY=your-msg91-auth-key
# MSG91_ROUTE=4

# EMAIL CONFIGURATION (Optional - for booking confirmations and notifications)
# ============================================================================
# Gmail SMTP Example:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@bseva.com

# Alternative: SendGrid Configuration
# SENDGRID_API_KEY=your-sendgrid-api-key
# SENDGRID_FROM_EMAIL=noreply@bseva.com

# FILE STORAGE (S3 - Optional for local development)
# ============================================================================
# AWS S3 Configuration (only needed if using file uploads)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=bseva-uploads

# DEVELOPMENT SETTINGS
# ============================================================================
# Set to 'development' for local development, 'production' for production
NODE_ENV=development

# Server port (default: 3000)
PORT=3000

# Enable verbose logging
DEBUG=bseva:*

# ============================================================================
# NOTES:
# ============================================================================
# 1. For local development, you can use placeholder values for external services
# 2. SMS and Email notifications will not work without proper credentials
# 3. Keep this file secure and never commit it to version control
# 4. Use strong, random values for JWT_SECRET in production
# 5. Update database credentials to match your local setup
# ============================================================================
