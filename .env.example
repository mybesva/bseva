# BSeva environment placeholders — copy to `.env` and fill real values.
# Do not commit secrets.

# --- Core ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
JWT_SECRET=change-me-min-32-characters-long-secret
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Supabase / storage ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=bseva
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Email (Zoho / SMTP) — required for real outbound mail (#14, #40, #43) ---
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=accounts@b-seva.com
# Optional from-address overrides (also seedable via admin platform settings):
# email_from_accounts / email_from_support / email_from_admin / email_from_info / email_from_contact

# --- SMS / OTP (#36) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Maps / Places (#19, #35, #48) ---
# Enable in Google Cloud: Maps JavaScript API, Places API, Geocoding API
# (Routes/Directions if you add live routing later)
VITE_GOOGLE_MAPS_API_KEY=

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_APP_TITLE=B-Seva

# --- Mobile ---
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# --- Payments (production) ---
# PAYMENT_GATEWAY=razorpay|stripe|wallet_only
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- WhatsApp (#2) — official number is stored in platform setting `bseva_whatsapp_number`
# Optional Business API later:
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# --- Invoice legal placeholders (#39) — set real values when ready ---
# Also configurable via Admin → Settings platform keys:
# invoice_company_name, invoice_gstin, invoice_company_address,
# invoice_prefix_customer, invoice_prefix_settlement
